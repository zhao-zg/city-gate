# ──────────────────────────────────────────
#  city-gate-cron 环境变量配置
#  复制为 .env 后填写实际值
# ──────────────────────────────────────────

# ── 必填：Cloudflare API Token ──
# 需要 Zone:DNS:Edit 权限
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ── 可选：账户2 Token（多账户场景） ──
CLOUDFLARE_API_TOKEN_2=

# ── 定时计划（cron 表达式） ──
# 默认每 6 小时
# 示例：
#   0 */6 * * *    — 每 6 小时
#   0 */4 * * *    — 每 4 小时
#   0 2,8,14,20 * * *  — 每天 2/8/14/20 点
#   0 0 * * *      — 每天零点
CRON_SCHEDULE=0 */6 * * *

# ── 运行模式 ──
# sync  = 执行 DNS A 记录同步（检测 IP + 更新 A 记录）
# check = 仅检测 DNS 状态（A 记录 + 1034 实测，不修改任何 DNS 记录）
RUN_MODE=sync

# ── 预览模式 ──
# 1 = 仅预览不执行修改（与 RUN_MODE=sync 配合使用）
# 0 = 正常执行
DRY_RUN=0

# ── A 记录配置 ──
# 每个 zone 分配的 A 记录 IP 数量（默认 2）
IP_PER_ZONE=2
# IP 去重前缀长度（默认 24，即 /24 同段只保留延迟最低的）
IP_DEDUP_PREFIX=24

# ── 时区 ──
TZ=Asia/Shanghai

# ── 通知（可选） ──
# 脚本执行失败时推送通知，支持 Bark / PushPlus / Server酱 等兼容 API
# 留空则不推送
NOTIFY_URL=
NOTIFY_TOKEN=

# ── Zone 配置覆盖（可选） ──
# 设置后跳过镜像内 wrangler.toml 扫描，直接使用此 JSON 作为 Zone 配置
# 不设置则自动使用镜像内打包的 wrangler.toml 配置
# 
# 格式与 wrangler.toml 中的 DOMAIN_CONFIG_JSON 一致，支持三种写法：
#
# 方式1 — 单账户（默认 tokenKey=default）:
#   {"zones":["a.com","b.com"],"groups":[{"prefix":"sg","origin":"https://sg.pages.dev"}]}
#
# 方式2 — 多账户（按 zone 指定 tokenKey）:
#   {"zones":[{"name":"a.com"},{"name":"b.com","tokenKey":"account2"}],"groups":[...]}
#
# 方式3 — 多账户（数组，每组独立 tokenKey）:
#   [{"tokenKey":"default","zones":["a.com"],"groups":[...]},{"tokenKey":"account2","zones":["b.com"],"groups":[...]}]
#
# noPreferred zone 也支持: {"name":"c.com","noPreferred":true}
# 注意: JSON 必须写成单行或多行转义，docker-compose .env 不支持多行值
# 建议用 docker-compose.yml 的 environment: 直接写多行
# ZONE_CONFIG_JSON=

# ──────────────────────────────────────────
#  部署说明
# ──────────────────────────────────────────
#
#  1. 拉取镜像并启动：
#     cd docker
#     cp .env.example .env
#     # 编辑 .env，填入 CLOUDFLARE_API_TOKEN
#     docker compose pull && docker compose up -d
#
#  2. 查看日志：
#     docker compose logs -f
#     # 或查看持久化日志
#     tail -f logs/sync-$(date +%Y%m%d).log
#
#  3. 手动执行一次：
#     docker compose exec city-gate-cron /entrypoint.sh run
#
#  4. 预览模式（不修改 DNS）：
#     docker compose exec city-gate-cron /entrypoint.sh dry-run
#
#  5. 更新镜像：
#     docker compose pull && docker compose up -d
