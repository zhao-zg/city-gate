# ──────────────────────────────────────────
#  city-gate-cron 环境变量配置
#  复制为 .env 后填写实际值
# ──────────────────────────────────────────

# ── 必填：Cloudflare API Token ──
# 需要 Zone:DNS:Edit 权限
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ── 可选：账户2 Token（多账户场景） ──
CLOUDFLARE_API_TOKEN_2=

# ── 定时计划（cron 表达式） ──
# 默认每 6 小时
# 示例：
#   0 */6 * * *    — 每 6 小时
#   0 */4 * * *    — 每 4 小时
#   0 2,8,14,20 * * *  — 每天 2/8/14/20 点
#   0 0 * * *      — 每天零点
CRON_SCHEDULE=0 */6 * * *

# ── 运行模式 ──
# sync  = 执行 DNS A 记录同步（检测 IP + 更新 A 记录）
# check = 仅检测 DNS 状态（A 记录 + 1034 实测，不修改任何 DNS 记录）
RUN_MODE=sync

# ── 预览模式 ──
# 1 = 仅预览不执行修改（与 RUN_MODE=sync 配合使用）
# 0 = 正常执行
DRY_RUN=0

# ── A 记录配置 ──
# 每个 zone 分配的 A 记录 IP 数量（默认 2）
IP_PER_ZONE=2
# IP 去重前缀长度（默认 32 = 仅去重完全相同的 IP，设为 24 则同 /24 段只保留延迟最低的）
IP_DEDUP_PREFIX=32

# ── 测速配置 ──
# 最低下载速度 KB/s（默认 500）
MIN_SPEED_KBPS=500
# 测速时长秒数（默认 2）
SPEED_TEST_SEC=2
# 延迟上限 ms，超过的 IP 不测速（默认 300，0=不限制）
MAX_LATENCY_MS=300
# 测速模式：fast = 达标即停 / best = 全部测完选最优 / off = 跳过测速（仅按延迟+丢包率排序）
# off 模式适合纯网页浏览场景，跳过下载测速可大幅缩短同步时间
SPEED_TEST_MODE=fast
# best 模式下最大测速 IP 数（默认 20，避免串行测速耗时过长）
MAX_SPEED_TEST_COUNT=20
# 测速域名（留空=自动检测，需为已部署 Worker 的域名，Worker 需有 /__down 路由）
# 设为自定义域名可指定测速使用的域名（如 sg.07170501.xyz）
SPEED_TEST_HOST=

# ── 数据中心过滤（可选） ──
# 逗号分隔的 CF 数据中心代码（如 HKG,LAX,SJC），仅选择指定数据中心的 IP
# 留空 = 不过滤（仍会在日志中展示每个 IP 的 colo 信息供参考）
# 完整代码列表见: https://www.cloudflare.com/ips/
COLO_FILTER=

# ── 延迟采样配置 ──
# 延迟采样次数（默认 10，1=单次不取平均）
# 多次采样取平均值，消除偶发网络抖动导致的误判
LATENCY_SAMPLES=10
# 丢包率上限，超过则过滤（默认 0.1 = 10%）
# 如 10 次采样中 2 次失败 = 20% > 10%，会被过滤
# 如 10 次采样中 1 次失败 = 10%，保留
MAX_PACKET_LOSS_RATE=0.1

# ── IP 来源模式（可选） ──
# domain = 从优选域名池解析 IP（默认，约 40-50 个）
# cidr   = 从 CF 官方 CIDR 范围随机采样 IP（覆盖面广）
# both   = 域名解析 + CIDR 采样合并（IP 池最大）
# 自定义 = 直接传入 CIDR/IP/域名混合（逗号分隔），如：
#         104.16.0.0/13,172.64.0.0/13,1.2.3.4,icook.hk
IP_SOURCE=domain
# 每个 CIDR 最多采样 IP 数（默认 100，cidr/both 模式生效）
# /13 网段有 50 万 IP，采样 100 个即可覆盖
CIDR_SAMPLES=100
# 是否补充 Cloudflare 官方 Top20 IP（默认关闭）
# 开启后会从 CF 官方域名解析获取约 20 个高质量 IP 加入候选池
# 适合域名解析 IP 较少时扩充池子，通常 domain 模式已够用
ENABLE_CF_TOP20=

# ── 时区 ──
TZ=Asia/Shanghai

# ── 通知（可选） ──
# 脚本执行失败时推送通知，支持 Bark / PushPlus / Server酱 等兼容 API
# 留空则不推送
NOTIFY_URL=
NOTIFY_TOKEN=

# ── Zone 配置覆盖（可选） ──
# 设置后跳过镜像内 wrangler.toml 扫描，直接使用此 JSON 作为 Zone 配置
# 不设置则自动使用镜像内打包的 wrangler.toml 配置
# 
# 格式与 wrangler.toml 中的 DOMAIN_CONFIG_JSON 一致，支持三种写法：
#
# 方式1 — 单账户（默认 tokenKey=default）:
#   {"zones":["a.com","b.com"],"groups":[{"prefix":"sg","origin":"https://sg.pages.dev"}]}
#
# 方式2 — 多账户（按 zone 指定 tokenKey）:
#   {"zones":[{"name":"a.com"},{"name":"b.com","tokenKey":"account2"}],"groups":[...]}
#
# 方式3 — 多账户（数组，每组独立 tokenKey）:
#   [{"tokenKey":"default","zones":["a.com"],"groups":[...]},{"tokenKey":"account2","zones":["b.com"],"groups":[...]}]
#
# noPreferred zone 也支持: {"name":"c.com","noPreferred":true}
# 注意: JSON 必须写成单行或多行转义，docker-compose .env 不支持多行值
# 建议用 docker-compose.yml 的 environment: 直接写多行
# ZONE_CONFIG_JSON=

# ──────────────────────────────────────────
#  部署说明
# ──────────────────────────────────────────
#
#  1. 拉取镜像并启动：
#     cd docker
#     cp .env.example .env
#     # 编辑 .env，填入 CLOUDFLARE_API_TOKEN
#     docker compose pull && docker compose up -d
#
#  2. 查看日志：
#     docker compose logs -f
#     # 或查看持久化日志
#     tail -f logs/sync-$(date +%Y%m%d).log
#
#  3. 手动执行一次：
#     docker compose exec city-gate-cron /entrypoint.sh run
#
#  4. 预览模式（不修改 DNS）：
#     docker compose exec city-gate-cron /entrypoint.sh dry-run
#
#  5. 更新镜像：
#     docker compose pull && docker compose up -d
