# ──────────────────────────────────────────
#  city-gate-cron 环境变量配置
#  复制为 .env 后填写实际值
# ──────────────────────────────────────────

# ── 必填：Cloudflare API Token ──
# 需要 Zone:DNS:Edit 权限
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ── 可选：账户2 Token（多账户场景） ──
CLOUDFLARE_API_TOKEN_2=

# ── 定时计划（cron 表达式） ──
# 默认每 6 小时（与 GitHub Actions 对齐）
# 示例：
#   0 */6 * * *    — 每 6 小时
#   0 */4 * * *    — 每 4 小时
#   0 2,8,14,20 * * *  — 每天 2/8/14/20 点
#   0 0 * * *      — 每天零点
CRON_SCHEDULE=0 */6 * * *

# ── 运行模式 ──
# sync  = 执行 DNS CNAME 同步（检测 + 更新 DNS 记录）
# check = 仅检测状态（不修改任何 DNS 记录）
RUN_MODE=sync

# ── 预览模式 ──
# 1 = 仅预览不执行修改（与 RUN_MODE=sync 配合使用）
# 0 = 正常执行
DRY_RUN=0

# ── 时区 ──
TZ=Asia/Shanghai

# ── 通知（可选） ──
# 脚本执行失败时推送通知，支持 Bark / PushPlus / Server酱 等兼容 API
# 留空则不推送
NOTIFY_URL=
NOTIFY_TOKEN=
